{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dimensify native packed LOD replay raw report",
  "type": "object",
  "required": [
    "schema_version",
    "protocol",
    "source",
    "environment",
    "render",
    "resource_usage",
    "cases",
    "publication_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol": {
      "enum": [
        "dimensify-native-lod-offscreen-v1",
        "dimensify-native-lod-stochastic-offscreen-v1"
      ]
    },
    "publication_eligible": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "required": [
        "sha256",
        "bounds",
        "generated"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generated": {
          "const": false
        }
      }
    },
    "environment": {
      "type": "object"
    },
    "render": {
      "type": "object",
      "required": [
        "backend",
        "projection_cache",
        "preset",
        "physical_resolution",
        "camera_protocol",
        "settings",
        "transparency"
      ],
      "properties": {
        "backend": {
          "const": "packed"
        },
        "projection_cache": {
          "const": true
        },
        "preset": {
          "enum": [
            "default",
            "constrained"
          ]
        },
        "physical_resolution": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "transparency": {
          "enum": [
            "sorted",
            "stochastic"
          ]
        }
      }
    },
    "resource_usage": {
      "type": "object",
      "required": [
        "schema_version",
        "checkpoints",
        "gpu_checkpoints",
        "unavailable"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/processCheckpoint"
          }
        },
        "gpu_checkpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gpuCheckpoint"
          }
        },
        "unavailable": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "name",
          "rows",
          "capture",
          "gpu_pass_reports",
          "gpu_pass_coverage"
        ],
        "properties": {
          "name": {
            "enum": [
              "static",
              "moving",
              "near-far-return"
            ]
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "sample_id",
                "completed_frame_ns",
                "app_update_wall_ns",
                "acknowledged_sort_and_draw",
                "stream",
                "gpu_pass_samples",
                "acknowledged_projected_sort_and_draw",
                "render_status"
              ],
              "properties": {
                "sample_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "completed_frame_ns": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "acknowledged_sort_and_draw": {
                  "type": "boolean"
                },
                "acknowledged_projected_sort_and_draw": {
                  "type": "boolean"
                },
                "acknowledged_projected_render": {
                  "type": "boolean"
                },
                "render_status": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "cloud_count",
                      "sort_encoded",
                      "draw_encoded",
                      "projected_draw_encoded",
                      "ready",
                      "projected_ready"
                    ],
                    "properties": {
                      "cloud_count": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "draw_encoded": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "projected_draw_encoded": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "capture": {
            "type": "object",
            "required": [
              "file",
              "rgba_sha256",
              "non_background_pixels"
            ],
            "properties": {
              "non_background_pixels": {
                "type": "integer",
                "minimum": 1
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "rgba_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "processCheckpoint": {
      "type": "object",
      "required": [
        "phase",
        "elapsed_ns",
        "rss_bytes",
        "virtual_memory_bytes",
        "accumulated_cpu_ms"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "elapsed_ns": {
          "type": "integer",
          "minimum": 0
        },
        "rss_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "virtual_memory_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "accumulated_cpu_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "bufferEntry": {
      "type": "object",
      "required": [
        "id",
        "bytes",
        "categories"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "bufferCategory": {
      "type": "object",
      "required": [
        "bytes",
        "buffers"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "buffers": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bufferInventory": {
      "type": "object",
      "required": [
        "live_bytes",
        "live_buffers",
        "peak_live_bytes",
        "observed_bytes_total",
        "observed_buffers_total",
        "entries_truncated",
        "entries",
        "categories",
        "packed_source_payload_bytes"
      ],
      "properties": {
        "live_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "live_buffers": {
          "type": "integer",
          "minimum": 0
        },
        "peak_live_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "observed_bytes_total": {
          "type": "integer",
          "minimum": 0
        },
        "observed_buffers_total": {
          "type": "integer",
          "minimum": 0
        },
        "entries_truncated": {
          "type": "integer",
          "minimum": 0
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bufferEntry"
          }
        },
        "categories": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/bufferCategory"
          }
        },
        "packed_source_payload_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "gpuCheckpoint": {
      "type": "object",
      "required": [
        "phase",
        "sample_id",
        "telemetry"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "sample_id": {
          "type": "integer",
          "minimum": 0
        },
        "telemetry": {
          "type": "object",
          "required": [
            "buffers"
          ],
          "properties": {
            "buffers": {
              "anyOf": [
                {
                  "$ref": "#/$defs/bufferInventory"
                },
                {
                  "type": "null"
                }
              ]
            },
            "buffers_unavailable_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "if": {
            "properties": {
              "buffers": {
                "type": "null"
              }
            }
          },
          "then": {
            "required": [
              "buffers_unavailable_reason"
            ],
            "properties": {
              "buffers_unavailable_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "protocol": {
            "const": "dimensify-native-lod-stochastic-offscreen-v1"
          }
        }
      },
      "then": {
        "properties": {
          "render": {
            "properties": {
              "transparency": {
                "const": "stochastic"
              }
            }
          },
          "cases": {
            "items": {
              "properties": {
                "rows": {
                  "items": {
                    "properties": {
                      "acknowledged_sort_and_draw": {
                        "const": false
                      },
                      "acknowledged_projected_sort_and_draw": {
                        "const": false
                      },
                      "render_status": {
                        "items": {
                          "required": [
                            "stochastic_draw_encoded",
                            "stochastic_ready",
                            "projected_stochastic_ready"
                          ],
                          "properties": {
                            "sort_encoded": {
                              "const": 0
                            },
                            "ready": {
                              "const": false
                            },
                            "projected_ready": {
                              "const": false
                            },
                            "stochastic_draw_encoded": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "stochastic_ready": {
                              "const": true
                            },
                            "projected_stochastic_ready": {
                              "const": true
                            }
                          }
                        }
                      },
                      "acknowledged_projected_render": {
                        "const": true
                      }
                    },
                    "required": [
                      "acknowledged_projected_render"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "render": {
            "properties": {
              "transparency": {
                "const": "sorted"
              }
            }
          },
          "cases": {
            "items": {
              "properties": {
                "rows": {
                  "items": {
                    "properties": {
                      "acknowledged_sort_and_draw": {
                        "const": true
                      },
                      "acknowledged_projected_sort_and_draw": {
                        "const": true
                      },
                      "render_status": {
                        "items": {
                          "required": [],
                          "properties": {
                            "sort_encoded": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "ready": {
                              "const": true
                            },
                            "projected_ready": {
                              "const": true
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
