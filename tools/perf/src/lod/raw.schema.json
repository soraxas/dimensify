{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dimensify native packed LOD replay raw report",
  "type": "object",
  "required": [
    "schema_version",
    "protocol",
    "source",
    "environment",
    "render",
    "resource_usage",
    "cases",
    "publication_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol": {
      "enum": [
        "dimensify-native-lod-offscreen-v1",
        "dimensify-native-lod-stochastic-offscreen-v1"
      ]
    },
    "publication_eligible": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "required": [
        "sha256",
        "bounds",
        "generated"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generated": {
          "const": false
        }
      }
    },
    "environment": {
      "type": "object"
    },
    "render": {
      "type": "object",
      "required": [
        "backend",
        "projection_cache",
        "preset",
        "physical_resolution",
        "camera_protocol",
        "settings"
      ],
      "properties": {
        "backend": {
          "const": "packed"
        },
        "projection_cache": {
          "const": true
        },
        "preset": {
          "enum": [
            "default",
            "constrained"
          ]
        },
        "transparency": {
          "enum": [
            "sorted",
            "stochastic"
          ]
        }
      }
    },
    "resource_usage": {
      "type": "object",
      "required": [
        "checkpoints",
        "gpu_checkpoints",
        "unavailable"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "name",
          "rows",
          "capture",
          "gpu_pass_reports",
          "gpu_pass_coverage"
        ],
        "properties": {
          "name": {
            "enum": [
              "static",
              "moving",
              "near-far-return"
            ]
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "sample_id",
                "completed_frame_ns",
                "app_update_wall_ns",
                "acknowledged_sort_and_draw",
                "stream",
                "gpu_pass_samples",
                "acknowledged_projected_sort_and_draw"
              ],
              "properties": {
                "sample_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "completed_frame_ns": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "acknowledged_sort_and_draw": {
                  "type": "boolean"
                },
                "acknowledged_projected_sort_and_draw": {
                  "type": "boolean"
                },
                "acknowledged_projected_render": {
                  "type": "boolean"
                }
              }
            }
          },
          "capture": {
            "type": "object",
            "required": [
              "file",
              "rgba_sha256",
              "non_background_pixels"
            ],
            "properties": {
              "non_background_pixels": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
