<?xml version="1.0"?>
<robot name="RoboSim demo arm">
  <material name="base"><color rgba="0.14 0.2 0.3 1"/></material>
  <material name="arm"><color rgba="0.95 0.48 0.1 1"/></material>
  <material name="tool"><color rgba="0.15 0.65 0.75 1"/></material>
  <link name="base">
    <visual><origin xyz="0 0 0.1"/><geometry><cylinder radius="0.25" length="0.2"/></geometry><material name="base"/></visual>
  </link>
  <link name="upper_arm">
    <visual><origin xyz="0 0 0.4"/><geometry><box size="0.16 0.16 0.8"/></geometry><material name="arm"/></visual>
  </link>
  <link name="forearm">
    <visual><origin xyz="0.3 0 0"/><geometry><box size="0.6 0.12 0.12"/></geometry><material name="arm"/></visual>
  </link>
  <link name="tool">
    <visual><geometry><sphere radius="0.1"/></geometry><material name="tool"/></visual>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="base"/><child link="upper_arm"/><origin xyz="0 0 0.2"/>
    <axis xyz="0 0 1"/><limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/><origin xyz="0 0 0.8"/>
    <axis xyz="0 1 0"/><limit lower="-1.5" upper="1.5" effort="10" velocity="1"/>
  </joint>
  <joint name="wrist" type="fixed">
    <parent link="forearm"/><child link="tool"/><origin xyz="0.6 0 0"/>
  </joint>
</robot>
